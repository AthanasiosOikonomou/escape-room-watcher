# Settings of the watchlist page (web/server.js). Copy to .env for a local run:
#   npm run web
# On the server these live in /etc/escape-room-watchlist.env instead.

# A fine-grained personal access token limited to this one repository, with
# "Contents: Read and write" (to save the list) and "Actions: Read and write"
# (to see the last check and start one). Nothing else.
GITHUB_TOKEN=
GITHUB_REPO=AthanasiosOikonomou/escape-room-watcher
GITHUB_BRANCH=main

# The page listens on this machine only; publish it with `tailscale serve`.
HOST=127.0.0.1
PORT=8787

# Extra host names the page may be opened under, comma separated.
# localhost and *.ts.net names are always accepted.
ALLOWED_HOSTS=

# The page also keeps the checks coming: when no run of the workflow began in
# the last this-many minutes, it starts one. 0 leaves it to GitHub's own schedule.
CHECK_EVERY_MINUTES=30
